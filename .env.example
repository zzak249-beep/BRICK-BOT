# ===== OBLIGATORIAS (salvo DRY_RUN=1) =====
TELEGRAM_BOT_TOKEN=
# Uno o varios chat ids separados por coma (usuario, grupo o canal)
TELEGRAM_CHAT_ID=

# ===== PRUEBAS =====
# 1 = imprime las señales en los logs en vez de enviarlas a Telegram
DRY_RUN=0
LOG_LEVEL=INFO

# ===== UNIVERSO DE PARES =====
# Vacío = todos los perpetuos -USDT de BingX en servicio con liquidez suficiente
SYMBOLS=
EXCLUDE=
# Volumen 24h mínimo en USDT (0 = sin filtro)
MIN_QUOTE_VOLUME_USDT=3000000
MAX_SYMBOLS=400
UNIVERSE_REFRESH_HOURS=6

# ===== API Y RENDIMIENTO =====
# Peticiones por segundo a BingX (sube con cuidado: hay límites por IP)
REQ_PER_SEC=8
WORKERS=8
# Segundos de espera tras cerrar cada vela de 5m antes de escanear
SCAN_DELAY_SEC=10
KLINES_LIMIT=400
# Se ignoran datos con más de N velas de antigüedad
MAX_AGE_BARS=2
# Ruta de velas (vacío = v3 con fallback automático a v2)
BINGX_KLINES_PATH=

# ===== ESTRATEGIA (mismos valores por defecto que la versión Pine) =====
LEVEL_MODE=day
ROLL_LEN=288
WARMUP_BARS=36
PERSIST_BARS=2
ALLOW_LONG=1
ALLOW_SHORT=1
ADR_LEN=20
USE_DM=1
DM_MIN=0.15
USE_ROOM=1
ROOM_THR=1.0
USE_QUIET=1
QUIET_SPAN=0.6
ATR_LEN=14
STOP_ATR=2.0
USE_COST_FILTER=1
# Debe ser comisión + slippage de ida y vuelta, en % del precio
RT_COST_PCT=0.12
MAX_COST_R=0.20
USE_HOURS=0
HOURS_FROM=7
HOURS_TO=21
EOD_BLOCK=1
MAX_SIGNALS_PER_DAY=2

# ===== TAMAÑO SUGERIDO EN EL MENSAJE (solo informativo) =====
ACCOUNT_USDT=1000
RISK_PCT=0.5
MAX_LEVERAGE=3
TP_R=2,3
